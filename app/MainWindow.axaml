<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OmarchyArmInstaller"
        xmlns:core="using:OmarchyArmInstaller.Core"
        xmlns:platform="using:OmarchyArmInstaller.Platform"
        x:Class="OmarchyArmInstaller.MainWindow"
        x:DataType="local:MainViewModel"
        Title="Omarchy Arm Installer"
        Icon="/Assets/omarchy.png"
        Width="920" Height="640" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.mark">
      <Setter Property="Width" Value="22" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    </Style>
    <Style Selector="TextBlock.mark.current">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.mark.done">
      <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
    </Style>
    <Style Selector="TextBlock.steptitle">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    </Style>
    <Style Selector="TextBlock.steptitle.current">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.notok">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <Style Selector="Button.choice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style Selector="StackPanel.step">
      <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="250,*" RowDefinitions="*,Auto">

    <!-- Steps -->
    <Border Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="26,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,34">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="{StaticResource OmarchyMark}" Fill="{StaticResource AccentBrush}" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="omarchy" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" Classes="dim" />
          <TextBlock Text="We can fix everything… once we get past Windows." Classes="dim" FontStyle="Italic"
                     FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" IsVisible="{Binding IsDemo}" Foreground="{StaticResource WarnBrush}"
                   TextWrapping="Wrap" FontSize="12"
                   Text="Demo: not running on Windows, so nothing is written." />
        <ItemsControl ItemsSource="{Binding StepItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:StepItem">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{Binding Mark}" Classes="mark" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}" />
                <TextBlock Text="{Binding Title}" Classes="steptitle" Classes.current="{Binding IsCurrent}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Current step -->
    <!-- The scrollbar stays visible when a step runs past the window, so a
         button or result below the fold is not mistaken for a missing one. -->
    <ScrollViewer x:Name="Page" Grid.Column="1" AllowAutoHide="False">
      <!-- The margin, not the ScrollViewer's Padding: padding is left out of
           the scrollable extent, so the end of a long step hid under the bar. -->
      <StackPanel Spacing="16" MaxWidth="600" Margin="36,28,36,28" HorizontalAlignment="Left">
        <TextBlock Text="{Binding StepTitle}" Classes="h1" />

        <!-- Start: what opening the installer found out about this computer -->
        <StackPanel Classes="step" IsVisible="{Binding IsStartStep}">

          <StackPanel Spacing="6" IsVisible="{Binding IsLooking}">
            <TextBlock Classes="body" Text="Reading this computer's hardware IDs, to see whether Linux has a device tree for it." />
            <TextBlock Text="{Binding ProgressText}" Classes="dim" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>

          <StackPanel Classes="step" IsVisible="{Binding NoDeviceTree}">
            <TextBlock Text="{Binding MachineName}" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Classes="body" Text="Linux starts on an Arm laptop through a device tree: a description of its hardware, written by hand for each model, because the firmware describes it only in the terms Windows' drivers use. There is no device tree for this model yet, so Omarchy cannot start on it, and this installer will not make a stick for it." />
            <Border Classes="panel">
              <StackPanel Spacing="4">
                <TextBlock Text="What a hardware report does" FontWeight="Bold" />
                <TextBlock Classes="dim body" Text="Whoever writes the device tree needs what this computer's firmware and Windows know about it: the ACPI tables, the hardware IDs, every device and its driver, the display's identity, and the names of the firmware files. Without the laptop in hand, that is what they ask for first. The report gathers it into one zip file, with serial numbers and other personal details taken out, and you send it through a form on GitHub." />
                <TextBlock Text="What it means" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock Classes="dim body" Text="· It takes about a minute, and nothing on this computer changes.&#10;· It is a start, not a promise. A device tree is weeks of work by someone who knows the hardware, and a report does not make one appear; it makes one possible, and shows there is a laptop waiting for it.&#10;· When a device tree for this model reaches Linux and systemd's list, this installer recognises the laptop and makes the stick. Watch the issue, or try a newer release." />
              </StackPanel>
            </Border>
            <Button Classes="primary" Content="Share a hardware report" Click="StartReport" HorizontalAlignment="Left" />
            <TextBlock Classes="dim body" FontSize="12" Text="{Binding ModelsNote}" />
          </StackPanel>

          <StackPanel Classes="step" IsVisible="{Binding NotArm}">
            <TextBlock Classes="body" Text="This installer is for Windows on Arm laptops: Snapdragon computers, whose firmware and device trees it deals in. This computer runs Windows on another kind of processor; for it, see omarchy.org." />
          </StackPanel>

          <StackPanel Classes="step" IsVisible="{Binding DetectFailed}">
            <TextBlock Classes="body warn" Text="This computer could not be read, so the installer cannot tell whether Linux has a device tree for it. You can still choose:" />
            <Button Classes="choice" Click="StartInstall">
              <StackPanel Spacing="6">
                <TextBlock Text="Make an Omarchy USB stick" FontWeight="Bold" />
                <TextBlock Classes="dim body" Text="A stick that installs Omarchy on this laptop and carries its firmware from Windows, so BitLocker can stay on and Windows can stay next to Omarchy." />
              </StackPanel>
            </Button>
            <Button Classes="choice" Click="StartReport">
              <StackPanel Spacing="6">
                <TextBlock Text="Share a hardware report" FontWeight="Bold" />
                <TextBlock Classes="dim body" Text="For any Windows on Arm laptop: collects what Linux developers need to support it, and helps you send it to them. Nothing on this computer changes." />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Hardware report -->
        <StackPanel Classes="step" IsVisible="{Binding IsCollectStep}">
          <TextBlock Classes="body" Text="Linux runs on Arm laptops through a device tree: a description of the hardware, written by hand for each model. Writing one takes what this computer's firmware and Windows know about it. This reads that and saves it as one zip file." />
          <Button Classes="primary" Content="Collect the report" Click="Collect" IsVisible="{Binding CanCollect}" HorizontalAlignment="Left" />
          <Border Classes="panel">
            <StackPanel Spacing="4">
              <TextBlock Text="What the report holds" FontWeight="Bold" />
              <TextBlock Classes="dim body" Text="· The firmware's ACPI and SMBIOS tables&#10;· The hardware IDs Linux's boot loader picks a device tree by&#10;· Every device, each property Windows has for it, its driver and where it sits in the firmware&#10;· Each device's and driver's registry settings, and the memory, interrupts and bus connections drivers were given&#10;· The built-in display's identity (EDID) and modes&#10;· The driver packages' INF files, and the names and checksums of the firmware files in them, not the firmware itself&#10;· What Windows' tools say about storage, the battery, power states, the GPU, thermal zones and the driver store" />
              <TextBlock Text="What it leaves out" FontWeight="Bold" Margin="0,8,0,0" />
              <TextBlock Classes="dim body" Text="Serial numbers, the system UUID, the Windows product key, MAC addresses, the computer and user names, paired Bluetooth devices, printers and drives, and registry values named as identifiers. You can look inside the zip before you send it." />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding ReportLog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LogLine">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                  <TextBlock Text="&#xf00c;" Classes="ok" IsVisible="{Binding Ok}" />
                  <TextBlock Text="&#xf254;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding !Ok}" />
                  <TextBlock Text="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="panel" IsVisible="{Binding HasReport}">
            <TextBlock Classes="body" Text="{Binding ReportFacts}" />
          </Border>
          <TextBlock Classes="body warn" Text="{Binding ReportProblems}" IsVisible="{Binding HasReportProblems}" />
        </StackPanel>

        <!-- Share it -->
        <StackPanel Classes="step" IsVisible="{Binding IsShareStep}">
          <TextBlock Classes="body" Text="The report is saved as" />
          <SelectableTextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" />
          <Button Content="Show the report" Click="ShowReport" HorizontalAlignment="Left" />
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="body" Text="1  Open the form on GitHub; it needs a free GitHub account. The model and its hardware IDs are filled in already." />
              <TextBlock Classes="body" Text="2  Drag the zip file into the form, where it says to attach the report." />
              <TextBlock Classes="body" Text="3  If you know where the manufacturer offers this model's drivers, add the link. Then submit it." />
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="Open the form on GitHub" Click="OpenReportForm" HorizontalAlignment="Left" />
          <TextBlock Classes="dim body" Text="Left out of the report:" Margin="0,6,0,0" />
          <TextBlock Classes="dim body" Text="{Binding ReportLeftOut}" />
        </StackPanel>

        <!-- This computer -->
        <StackPanel Classes="step" IsVisible="{Binding IsMachineStep}">
          <TextBlock Classes="body" Text="This makes a USB stick that installs Omarchy on this computer. It carries the firmware Linux needs from this computer's own Windows, so BitLocker can stay on, and Windows can stay next to Omarchy or make way for it." />
          <StackPanel Spacing="6" IsVisible="{Binding Busy}">
            <TextBlock Text="{Binding ProgressText}" Classes="dim" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
          <TextBlock Text="{Binding MachineName}" FontWeight="Bold" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding MachineChecks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Check">
                <Grid ColumnDefinitions="22,*" RowDefinitions="Auto,Auto" Margin="0,4">
                  <TextBlock Text="{Binding Mark}" Classes.ok="{Binding Ok}" Classes.notok="{Binding !Ok}" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" />
                  <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" Classes="dim" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="body" Text="{Binding MachineNote}" IsVisible="{Binding HasMachineNote}"
                     Classes.warn="{Binding MachineUnsupported}" />
          <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasRecipeNote}">
            <TextBlock Text="&#xf0b7c;" FontSize="17" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="body" Text="A recipe is available for this computer model" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Grid.Row="1" Classes="dim" FontSize="12" Text="{Binding RecipeNoteDetail}"
                       IsVisible="{Binding HasRecipeNoteDetail}" />
          </Grid>
          <Button Content="Share a hardware report instead" Click="SwitchToReport" Classes.primary="{Binding MachineUnsupported}"
                  IsVisible="{Binding !Busy}" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Firmware -->
        <StackPanel Classes="step" IsVisible="{Binding IsFirmwareStep}">
          <TextBlock Classes="body" Text="Graphics, sound, sensors, Wi-Fi and the battery gauge need firmware that only Windows has. These files are copied from this computer's drivers onto the stick, and only there: nothing is uploaded or shared." />
          <ItemsControl ItemsSource="{Binding Firmware}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:FirmwarePackage">
                <Border Classes="panel" Margin="0,0,0,6">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="&#xf00c;" Classes="ok" IsVisible="{Binding Complete}" />
                      <TextBlock Text="&#xf00d;" Classes="notok" IsVisible="{Binding !Complete}" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Classes="dim" FontSize="12" Margin="22,0,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="dim body" FontSize="12" Text="{Binding FirmwareSummary}" />
        </StackPanel>

        <!-- Extras -->
        <StackPanel Classes="step" IsVisible="{Binding IsExtrasStep}">
          <TextBlock Classes="body" Text="Some computer models need a little extra software than Omarchy carries in the ISO, or has changes that are not yet merged into Omarchy or the Linux kernel. This recipe adds any additional software or those unmerged changes to provide a great out of box experience." />
          <Border Classes="panel" BorderBrush="{StaticResource WarnBrush}">
            <Grid ColumnDefinitions="26,*">
              <TextBlock Text="&#xf071;" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
              <TextBlock Grid.Column="1" Classes="body warn" Text="These recipes may come from repos that are not vetted by Omarchy, and should be reviewed." />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="26,*,Auto">
            <TextBlock Text="&#xf0b7c;" FontSize="17" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding RecipeTitle}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseRecipe}" IsEnabled="{Binding CanUseRecipe}"
                          OnContent="On" OffContent="Off" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="dim body" Text="Checking the repository and its signatures…" IsVisible="{Binding RecipeLoading}" />
          <TextBlock Classes="body warn" Text="{Binding RecipeProblem}" IsVisible="{Binding HasRecipeProblem}" />
          <TextBlock Classes="body warn" Text="{Binding RecipeRetiredText}" IsVisible="{Binding RecipeRetired}" />

          <!-- What the recipe adds from Omarchy's own repositories -->
          <StackPanel Spacing="8" IsVisible="{Binding CanUseRecipe}">
            <TextBlock Text="From Omarchy" FontWeight="Bold" />
            <TextBlock Classes="dim body" FontSize="12" Text="{Binding OfficialStatus}" IsVisible="{Binding HasOfficialStatus}" />
            <TextBlock Classes="body warn" FontSize="12" Text="{Binding OfficialProblem}" IsVisible="{Binding HasOfficialProblem}" />
            <Border Classes="panel" IsVisible="{Binding HasOfficialItems}">
              <ItemsControl ItemsSource="{Binding OfficialItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:OfficialItem">
                    <Grid ColumnDefinitions="22,*" Margin="0,2">
                      <TextBlock Text="&#xf00c;" Classes="ok" FontSize="12" VerticalAlignment="Center" />
                      <WrapPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                      </WrapPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- What it adds from outside Omarchy, by repository -->
          <StackPanel Spacing="8" IsVisible="{Binding CanUseRecipe}">
            <TextBlock Text="From outside Omarchy" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
            <ItemsControl ItemsSource="{Binding OutsideRepos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OutsideRepo">
                  <Border Classes="panel" BorderBrush="{StaticResource WarnBrush}" Margin="0,0,0,8">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <WrapPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Size}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                        </WrapPanel>
                        <HyperlinkButton NavigateUri="{Binding Link}" Content="{Binding Link}" IsVisible="{Binding HasLink}"
                                         Padding="0" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Classes="dim" FontSize="12" Text="{Binding Source}" TextWrapping="Wrap" />
                        <TextBlock Classes="dim body" FontSize="12" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" Margin="0,4,0,0" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:OutsidePackage">
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                              <WrapPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,12,0" />
                                <TextBlock Text="replaces Omarchy's" Classes="warn" FontSize="12" VerticalAlignment="Center"
                                           IsVisible="{Binding Replaces}" />
                              </WrapPanel>
                              <TextBlock Classes="dim body" FontSize="12" Text="{Binding Description}" />
                              <WrapPanel IsVisible="{Binding HasUpstream}">
                                <TextBlock Classes="dim" FontSize="12" Text="On its way into Omarchy: " VerticalAlignment="Center" />
                                <HyperlinkButton NavigateUri="{Binding Upstream}" Content="{Binding Upstream}"
                                                 Padding="0" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                              </WrapPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="dim body" FontSize="12" Text="{Binding $parent[Window].((local:MainViewModel)DataContext).OutsideNote}" />
                      <TextBlock Classes="ok body" FontSize="12"
                                 Text="&#xf00c;  Signed by the key this installer's recipe for this model names. The packages are checked again when Omarchy installs them." />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="dim body" FontSize="12" Text="{Binding RecipeDownload}" IsVisible="{Binding UseRecipe}" />
          <TextBlock Classes="body warn" IsVisible="{Binding StickTooSmall}"
                     Text="The firmware and the recipe together are more than the stick's firmware partition holds." />
          <TextBlock Classes="dim body" Text="Turn the recipe off to install Omarchy as it comes." IsVisible="{Binding UseRecipe}" />
        </StackPanel>

        <!-- Installer -->
        <StackPanel Classes="step" IsVisible="{Binding IsInstallerStep}">
          <TextBlock Classes="body" Text="The Omarchy installer for Arm laptops: Omarchy as it comes, able to read the firmware and extras this tool puts on the stick." />
          <Border Classes="panel">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Download" Click="Download" IsEnabled="{Binding CanDownload}" />
              <TextBlock Text="{Binding ReleaseText}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="or" Classes="dim" VerticalAlignment="Center" />
            <Button Content="Choose an ISO file…" Click="ChooseIso" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding Busy}">
            <TextBlock Text="{Binding ProgressText}" Classes="dim" />
            <ProgressBar Value="{Binding Progress}" Maximum="1" />
          </StackPanel>
          <TextBlock Classes="body" Text="{Binding ImageText}" />
          <TextBlock Classes="dim body" FontSize="12" Text="{Binding OfficialText}" IsVisible="{Binding HasOfficial}" />
          <TextBlock Classes="body warn" Text="{Binding OfficialProblem}" IsVisible="{Binding ShowOfficialProblem}" />
        </StackPanel>

        <!-- USB stick -->
        <StackPanel Classes="step" IsVisible="{Binding IsStickStep}">
          <TextBlock Classes="body" Text="Plug in a USB stick of 8 GB or more. Everything on it will be erased." />
          <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="platform:UsbDisk">
                <TextBlock Text="{Binding Description}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="dim body" IsVisible="{Binding NoDisks}" Text="No USB stick of 8 GB or more found." />
          <Button Content="Look again" Click="Refresh" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Windows -->
        <StackPanel Classes="step" IsVisible="{Binding IsWindowsStep}">
          <RadioButton GroupName="windows" IsChecked="{Binding KeepWindows}">
            <StackPanel Spacing="6">
              <TextBlock Text="Keep Windows next to Omarchy" FontWeight="Bold" />
              <TextBlock Classes="dim body" Text="Omarchy installs into unallocated space on this disk. Omarchy's boot menu lists Windows, and Omarchy can restart into it." />
            </StackPanel>
          </RadioButton>
          <Border Classes="panel" Margin="30,0,0,0" IsVisible="{Binding KeepWindows}">
            <StackPanel Spacing="10">
              <TextBlock Text="Make room in Disk Management" FontWeight="Bold" />
              <TextBlock Classes="dim body" Text="1  Right-click C: and choose Shrink Volume.&#10;2  Enter the amount to shrink in MB (20480 is 20 GB, 102400 is 100 GB) and choose Shrink. Leave the new space unallocated: don't make a volume in it.&#10;3  Come back here and choose Check again." />
              <TextBlock Classes="dim body" FontSize="12" Text="If Windows offers less room than you expect, turn off hibernation (powercfg /h off) and Fast Startup, or shrink again after a restart." />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open Disk Management" Click="OpenDiskManagement" />
                <Button Content="Check again" Click="CheckDisk" IsEnabled="{Binding !Busy}" />
              </StackPanel>
              <TextBlock Classes="body" Text="{Binding DiskFreeText}" Classes.ok="{Binding !DiskFreeLow}" Classes.warn="{Binding DiskFreeLow}" />
            </StackPanel>
          </Border>
          <RadioButton GroupName="windows" IsChecked="{Binding ReplaceWindows}">
            <StackPanel Spacing="6">
              <TextBlock Text="Replace Windows with Omarchy" FontWeight="Bold" />
              <TextBlock Classes="dim body" Text="Windows is left as it is now; Omarchy's installer erases the whole disk." />
            </StackPanel>
          </RadioButton>
          <Border Classes="panel" Margin="30,0,0,0" IsVisible="{Binding ReplaceWindows}" BorderBrush="{StaticResource WarnBrush}">
            <StackPanel Spacing="10">
              <TextBlock Text="You are about to wipe Windows" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
              <TextBlock Classes="body" Text="The firmware this stick is about to carry comes out of Windows' own drivers. Nobody may redistribute it, so we can't hand you a copy later, and on some laptops reinstalling Windows is the only other way to get it back." />
              <TextBlock Classes="body" Text="Keep this stick safe after the install, or copy its OMARCHY_FW folder somewhere you keep backups. It is what a reinstall or a rescue of Omarchy needs." />
            </StackPanel>
          </Border>

          <Border Classes="panel" IsVisible="{Binding BitLocker.On}" BorderBrush="{StaticResource WarnBrush}">
            <StackPanel Spacing="10">
              <TextBlock Text="BitLocker is on" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
              <TextBlock Classes="body" Text="Omarchy needs Secure Boot off, and Windows may then ask for its recovery key. The installer pauses BitLocker for the next three starts, but keep the key safe in case: save it somewhere other than this computer and the stick." />
              <SelectableTextBlock Text="{Binding RecoveryKeys}" FontSize="16" />
              <Button Content="Save the recovery key…" Click="SaveKey" HorizontalAlignment="Left" />
              <CheckBox IsChecked="{Binding KeySaved}" Content="I have saved my recovery key" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Create -->
        <StackPanel Classes="step" IsVisible="{Binding IsCreateStep}">
          <TextBlock Classes="body" Text="{Binding Summary}" />
          <Button Classes="primary" Content="Create the USB stick" Click="Create" IsVisible="{Binding !Busy}" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding CreateLog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LogLine">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                  <TextBlock Text="&#xf00c;" Classes="ok" IsVisible="{Binding Ok}" />
                  <TextBlock Text="&#xf254;" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding !Ok}" />
                  <TextBlock Text="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="6" IsVisible="{Binding Busy}">
            <TextBlock Text="{Binding ProgressText}" Classes="dim" />
            <ProgressBar Value="{Binding Progress}" Maximum="1" />
            <Button Content="Stop" Click="Cancel" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>

        <!-- Next steps -->
        <StackPanel Classes="step" IsVisible="{Binding IsDoneStep}">
          <TextBlock Classes="body" Text="The stick is ready. Leave it plugged in, then:" />
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="body" Text="{Binding SecureBootText, StringFormat='1  {0}'}" />
              <TextBlock Classes="body" Text="{Binding BootFromUsbText, StringFormat='2  {0}'}" />
              <TextBlock Classes="body" Text="3  In the installer, choose the free space to keep Windows, or the whole disk to replace it." />
            </StackPanel>
          </Border>
          <TextBlock Classes="dim body" Text="Omarchy reads this computer's firmware, and any extras, from the stick while it installs; nothing else is needed." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Error and navigation -->
    <Border Grid.Column="1" Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="36,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <Button Content="Open log" Click="OpenLog" IsVisible="{Binding HasError}" />
          <Button Content="Report a problem" Click="ReportProblem" IsVisible="{Binding HasError}" />
          <Button Content="Back" Click="Back" IsEnabled="{Binding CanGoBack}" IsVisible="{Binding !IsStartStep}" />
          <Button Classes="primary" Content="Next" Click="Next" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding ShowNext}" />
          <Button Classes="primary" Content="Close" Click="Close" IsVisible="{Binding ShowClose}" />
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
