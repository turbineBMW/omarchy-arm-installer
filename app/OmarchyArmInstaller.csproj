<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Omarchy's mark, as the exe's icon. Assets\omarchy.svg is the source. -->
    <ApplicationIcon>Assets\omarchy.ico</ApplicationIcon>
    <AssemblyName>OmarchyArmInstaller</AssemblyName>
    <RootNamespace>OmarchyArmInstaller</RootNamespace>
    <Product>Omarchy Arm Installer</Product>
    <Version>1.0.0</Version>
    <!-- One self-contained executable for Windows on Arm. -->
    <RuntimeIdentifiers>win-arm64;linux-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\omarchy.png" />
    <!-- The models systemd-stub knows, read at run time. -->
    <EmbeddedResource Include="Assets\models.json" LogicalName="models.json" />
  </ItemGroup>

</Project>
