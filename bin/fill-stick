#!/usr/bin/env python3
"""Fill a stick's OMARCHY_FW volume the way the Windows app does.

  bin/fill-stick VOLUME --firmware FILEREPOSITORY

FILEREPOSITORY is a Windows DriverStore/FileRepository, such as one on the
laptop's Windows partition mounted from Linux. Without a device list to go
by, every Qualcomm package (qc*) gives its firmware files.
"""

import argparse
import shutil
from pathlib import Path

# Drivers and Windows plumbing, as the app's ReportBuilder.NotFirmware.
NOT_FIRMWARE = {".sys", ".dll", ".exe", ".cat", ".inf", ".pnf", ".mui", ".cpl", ".ocx", ".msi", ".ps1",
                ".bat", ".cmd", ".winmd", ".pdb", ".chm", ".ico", ".lnk"}


def copy_firmware(store: Path, volume: Path) -> int:
    dest = volume / "DriverStore" / "FileRepository"
    copied = 0
    for folder in sorted(store.iterdir()):
        if not (folder.is_dir() and folder.name.lower().startswith("qc")):
            continue
        for path in folder.rglob("*"):
            if path.is_file() and path.suffix.lower() not in NOT_FIRMWARE:
                target = dest / folder.name / path.relative_to(folder)
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, target)
                copied += 1
    return copied


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("volume", type=Path)
    parser.add_argument("--firmware", type=Path, required=True)
    args = parser.parse_args()
    print(f"==> Firmware from {args.firmware}")
    print(f"    {copy_firmware(args.firmware, args.volume)} files")


if __name__ == "__main__":
    main()
