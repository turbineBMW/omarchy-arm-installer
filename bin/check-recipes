#!/usr/bin/env python3
"""Check every recipes/*/recipe.json: the fields the app and the installer
read, the same limits the installer applies, and that key.asc is the key
the recipe names (needs gpg). Then, unless --no-network, that each recipe
installs offline from the latest published image: its repository's database
is fetched, and every dependency must be in the image's offline mirror, in
the repository, or in Omarchy's and Arch's repositories (those are listed:
the stick carries them). OFFLINE_DB=path uses that database instead of the
latest release's."""

import json
import os
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import pacmandb  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
RELEASES = "https://api.github.com/repos/turbineBMW/omarchy-arm-installer/releases?per_page=30"
RESERVED = {"options", "offline", "omarchy", "core", "extra", "multilib", "alarm", "aur", "platform"}
CHID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def check(folder: Path) -> list[str]:
    problems = []
    try:
        r = json.loads((folder / "recipe.json").read_text())
    except (OSError, ValueError) as e:
        return [f"recipe.json: {e}"]
    if r.get("id") != folder.name:
        problems.append(f"id {r.get('id')!r} is not the folder name")
    for field in ("name", "device"):
        if not isinstance(r.get(field), str) or not r[field]:
            problems.append(f"{field} is missing")
    if r.get("status") not in ("tested", "untested"):
        problems.append("status is neither tested nor untested")
    if not isinstance(r.get("maintainer"), dict) or not r["maintainer"].get("name"):
        problems.append("maintainer.name is missing")
    chids = (r.get("match") or {}).get("chids") or []
    if not chids or not all(isinstance(c, str) and CHID.fullmatch(c) for c in chids):
        problems.append("match.chids needs lower-case CHIDs")
    repo = r.get("repo") or {}
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,39}", repo.get("name", "")) or repo.get("name") in RESERVED:
        problems.append("repo.name is not a name pacman and the installer accept")
    if not re.fullmatch(r"https://\S+", repo.get("server", "")):
        problems.append("repo.server must be https")
    fingerprint = repo.get("keyFingerprint", "")
    if not re.fullmatch(r"[0-9A-F]{40}", fingerprint):
        problems.append("repo.keyFingerprint must be 40 upper-case hex digits")
    packages = r.get("packages") or []
    if not packages or not all(isinstance(p, str) and re.fullmatch(r"[a-z0-9@._+-]+", p) for p in packages):
        problems.append("packages needs package names")
    for need in r.get("firmware", []):
        if not isinstance(need.get("folder"), str) or not need.get("files"):
            problems.append(f"firmware entry {need} needs a folder and files")
    key = folder / "key.asc"
    if not key.is_file():
        problems.append("key.asc is missing")
    else:
        out = subprocess.run(["gpg", "--show-keys", "--with-colons", str(key)], capture_output=True, text=True).stdout
        fingerprints = [line.split(":")[9] for line in out.splitlines() if line.startswith("fpr:")]
        if fingerprint not in fingerprints:
            problems.append(f"key.asc is not key {fingerprint}")
    return problems


def fetch(url: str) -> bytes:
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "check-recipes"}), timeout=120) as r:
        return r.read()


def latest_offline_db() -> bytes | None:
    """The offline mirror database published with the newest installer image."""
    if os.environ.get("OFFLINE_DB"):
        return Path(os.environ["OFFLINE_DB"]).read_bytes()
    for release in json.loads(fetch(RELEASES)):
        if not release["tag_name"].startswith("installer-") or release["draft"]:
            continue
        for asset in release["assets"]:
            if asset["name"].endswith(".offline.db"):
                return fetch(asset["browser_download_url"])
    return None


def check_offline(folder: Path, offline_db: bytes, official_dbs) -> list[str]:
    """What the stick carries from the official repositories for this recipe,
    or the dependency nothing provides."""
    r = json.loads((folder / "recipe.json").read_text())
    server = r["repo"]["server"].replace("$arch", pacmandb.ARCH)
    try:
        recipe_db = pacmandb.read_db(fetch(f"{server}/{r['repo']['name']}.db"))
        description = json.loads(fetch(f"{server}/{r['repo']['name']}.recipe.json"))
    except Exception as e:  # noqa: BLE001
        return [f"repository: {e}"]
    missing = [p for p in r["packages"] if p not in recipe_db]
    if missing:
        return [f"the repository has no {', '.join(missing)}"]
    try:
        official = pacmandb.resolve_official(list(r["packages"]) + list(description.get("official", [])),
                                             recipe_db, pacmandb.read_db(offline_db), official_dbs)
    except LookupError as e:
        return [f"nothing provides {e}: not the image, not the repository, not Omarchy's or Arch's repositories"]
    print(f"  from the official repositories, on the stick: {' '.join(f'{repo}/{p.name}' for repo, _, p in official) or 'nothing'}")
    return []


failed = False
folders = sorted(p for p in (ROOT / "recipes").iterdir() if p.is_dir())
for folder in folders:
    problems = check(folder)
    print(f"{folder.name}: {'ok' if not problems else '; '.join(problems)}")
    failed |= bool(problems)

if "--no-network" not in sys.argv and not failed:
    offline_db = latest_offline_db()
    if offline_db is None:
        print("no published image carries an offline mirror database yet; skipping the offline check")
    else:
        official_dbs = [(r, u, pacmandb.read_db(fetch(f"{u}/{r}.db"))) for r, u in pacmandb.OFFICIAL_REPOS]
        for folder in folders:
            print(f"{folder.name}: offline install")
            problems = check_offline(folder, offline_db, official_dbs)
            print(f"  {'ok' if not problems else '; '.join(problems)}")
            failed |= bool(problems)
sys.exit(1 if failed else 0)
