From 8e9abce01545b6ca91b5c3ad68c620db79aa16de Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Sat, 24 Oct 2026 13:00:20 -0400
Subject: [PATCH 3/4] Give aarch64 images an empty OMARCHY_FW partition for
 Windows firmware

Writing the image and then appending a partition is easy from Linux but
not from Windows, where the image's backup GPT sits mid-disk. A 1 GiB
FAT32 partition labelled OMARCHY_FW (Microsoft basic data) is appended to
the image as partition 3 instead, so a USB creator in Windows only writes
the image, then copies the firmware, and any device recipe's packages,
onto the volume Windows mounts. The installer reads it when it holds
firmware and skips it when empty.

Validated: the mkarchiso patch applies after the GRUB and boot-efi ones;
the partition image formats as FAT32 with 4 KiB clusters.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../archiso-v87-aarch64-firmware-partition.patch   | 14 ++++++++++++++
 builder/build-iso.sh                               |  7 +++++++
 2 files changed, 21 insertions(+)
 create mode 100644 builder/archiso-v87-aarch64-firmware-partition.patch

diff --git a/builder/archiso-v87-aarch64-firmware-partition.patch b/builder/archiso-v87-aarch64-firmware-partition.patch
new file mode 100644
index 0000000..bcb5ab7
--- /dev/null
+++ b/builder/archiso-v87-aarch64-firmware-partition.patch
@@ -0,0 +1,14 @@
+--- mkarchiso
++++ mkarchiso
+@@ -1391,6 +1391,11 @@
+     [[ " ${xorrisofs_options[*]} " =~ ' -partition_offset ' ]] || xorrisofs_options+=('-partition_offset' '16')
+     # Attach efiboot.img as a second partition and set its partition type to "EFI system partition"
+     xorrisofs_options+=('-append_partition' '2' 'C12A7328-F81F-11D2-BA4B-00A0C93EC93B' "${efibootimg}")
++    # An empty FAT partition labelled OMARCHY_FW (Microsoft basic data, so
++    # Windows mounts it) that a USB creator fills with firmware from Windows.
++    if [[ -f /tmp/omarchy-firmware-partition.img ]]; then
++        xorrisofs_options+=('-append_partition' '3' 'EBD0A0A2-B9E5-4433-87C0-68B6B72699C7' '/tmp/omarchy-firmware-partition.img')
++    fi
+     # Ensure GPT is used as some systems do not support UEFI booting without it
+     # shellcheck disable=SC2076
+     if [[ ! " ${bootmodes[*]} " =~ ' bios.syslinux ' ]]; then
diff --git a/builder/build-iso.sh b/builder/build-iso.sh
index d1e4741..0821846 100755
--- a/builder/build-iso.sh
+++ b/builder/build-iso.sh
@@ -132,6 +132,13 @@ if [[ $OMARCHY_ARCH == aarch64 ]]; then
   # A Snapdragon laptop boots the live system from a UKI built into /boot;
   # carry it onto the ISO beside the kernel when the build made one.
   patch --batch --forward --fuzz=0 "$mkarchiso_command" </builder/archiso-v87-aarch64-boot-efi.patch
+  # Snapdragon laptops need vendor firmware the image cannot carry. An empty
+  # 1 GiB OMARCHY_FW partition rides along, for a USB creator in Windows to
+  # fill from the unlocked driver store after writing the image, along with
+  # any device recipe's packages. 4 KiB clusters keep it FAT32 for Windows.
+  patch --batch --forward --fuzz=0 "$mkarchiso_command" </builder/archiso-v87-aarch64-firmware-partition.patch
+  rm -f /tmp/omarchy-firmware-partition.img
+  mkfs.vfat -C -F 32 -s 8 -n OMARCHY_FW /tmp/omarchy-firmware-partition.img $((1024 * 1024)) >/dev/null
   chmod 0755 "$mkarchiso_command"
 else
   # The container's own tools come from the channel's Omarchy mirror too; the
