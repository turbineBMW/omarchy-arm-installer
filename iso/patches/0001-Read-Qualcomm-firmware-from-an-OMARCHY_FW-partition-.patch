From 708465479a631012d4e5d9a66928aaa39e0ba917 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Sat, 24 Oct 2026 11:43:13 -0400
Subject: [PATCH 1/3] Read Qualcomm firmware from an OMARCHY_FW partition on
 the install media

A USB creator running in Windows can copy the firmware out of the unlocked
driver store onto a FAT partition labelled OMARCHY_FW, so the installer
never has to read a BitLocker-encrypted Windows partition. Each such
partition's DriverStore/FileRepository is staged with
qcom-firmware-extract -d until one yields files (the tool writes an empty
manifest when it finds none), and that driver store is carried into the
target for board packages' own Windows files. The Windows partition stays
the fallback.

Validated on a Surface Pro 11: against a stick image on loop devices, with
an empty OMARCHY_FW partition attached first, staging skipped it, staged
all five owner firmware files from the second and carried the sensor
configuration across; unit tests pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../omarchy-iso/orchestrator/phases_impl.py   |  49 ++++++++
 test/unit/test_firmware_partition.py          | 118 ++++++++++++++++++
 2 files changed, 167 insertions(+)
 create mode 100644 test/unit/test_firmware_partition.py

diff --git a/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py b/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
index 42eb2d7..1f068ae 100644
--- a/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
+++ b/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
@@ -196,10 +196,59 @@ LIVE_FIRMWARE_STAGE = Path("/run/omarchy/firmware")
 TARGET_FIRMWARE_STAGE = Path("var/lib/omarchy/firmware-stage")
 
 
+# A FAT partition with this label on the install media can carry the
+# firmware instead of the Windows partition: a USB creator running in Windows
+# copies it from the unlocked driver store, so BitLocker never has to be
+# turned off. Its DriverStore/FileRepository holds the driver packages' files
+# under their package folder names, the layout Windows itself uses.
+FIRMWARE_PARTITION_LABEL = "OMARCHY_FW"
+FIRMWARE_PARTITION_MOUNT = Path("/run/omarchy/firmware-partition")
+STAGED_DRIVER_STORE = "driver-store"
+
+
+def _firmware_partitions() -> list[str]:
+    out = subprocess.run(
+        ["lsblk", "-rno", "PATH,LABEL,FSTYPE"], capture_output=True, text=True, check=False
+    ).stdout
+    found = []
+    for line in out.splitlines():
+        fields = line.split(" ")
+        if len(fields) == 3 and fields[1] == FIRMWARE_PARTITION_LABEL and fields[2] == "vfat":
+            found.append(fields[0])
+    return found
+
+
+def _firmware_staged() -> bool:
+    # qcom-firmware-extract writes its manifest even when it found nothing.
+    manifest = LIVE_FIRMWARE_STAGE / "manifest"
+    return manifest.is_file() and manifest.stat().st_size > 0
+
+
 def _stage_qualcomm_firmware() -> None:
     tool = shutil.which("qcom-firmware-extract")
     if not tool:
         return
+    for partition in _firmware_partitions():
+        FIRMWARE_PARTITION_MOUNT.mkdir(parents=True, exist_ok=True)
+        mounted = subprocess.run(
+            ["mount", "-o", "ro,nosuid,nodev,noexec", partition, str(FIRMWARE_PARTITION_MOUNT)],
+            check=False,
+        ).returncode == 0
+        if not mounted:
+            continue
+        try:
+            store = FIRMWARE_PARTITION_MOUNT / "DriverStore" / "FileRepository"
+            if store.is_dir():
+                info(f"› saving Qualcomm firmware from the {FIRMWARE_PARTITION_LABEL} partition {partition}")
+                subprocess.run([tool, "--stage", str(LIVE_FIRMWARE_STAGE), "-d", str(store)], check=False)
+                if _firmware_staged():
+                    # Board packages read their own Windows configuration
+                    # (sensor calibration, say) from the copy the target gets.
+                    shutil.copytree(store, LIVE_FIRMWARE_STAGE / STAGED_DRIVER_STORE, dirs_exist_ok=True)
+        finally:
+            subprocess.run(["umount", str(FIRMWARE_PARTITION_MOUNT)], check=False)
+        if _firmware_staged():
+            return
     info("› saving Qualcomm firmware from Windows before the disk is written")
     # Firmware extraction is idempotent and optional.
     subprocess.run([tool, "--stage", str(LIVE_FIRMWARE_STAGE)], check=False)
diff --git a/test/unit/test_firmware_partition.py b/test/unit/test_firmware_partition.py
new file mode 100644
index 0000000..0e8fc27
--- /dev/null
+++ b/test/unit/test_firmware_partition.py
@@ -0,0 +1,118 @@
+"""Firmware from an OMARCHY_FW partition on the install media, which a
+Windows-side USB creator fills from the unlocked driver store, before the
+installer falls back to reading the Windows partition."""
+
+import shutil
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "configs/airootfs/usr/share/omarchy-iso"))
+sys.modules.setdefault(
+    "orchestrator.archinstall_adapter",
+    types.ModuleType("orchestrator.archinstall_adapter"),
+)
+from orchestrator import phases_impl  # noqa: E402
+
+
+def lsblk(stdout):
+    return types.SimpleNamespace(stdout=stdout, returncode=0)
+
+
+class FirmwarePartitionTest(unittest.TestCase):
+    def test_finds_every_labelled_fat_partition(self):
+        out = ("/dev/sda1 OMARCHY_ISO iso9660\n/dev/sda3 OMARCHY_FW vfat\n"
+               "/dev/nvme0n1p3 Local\\x20Disk ntfs\n/dev/sdb3 OMARCHY_FW vfat\n")
+        with mock.patch.object(phases_impl.subprocess, "run", return_value=lsblk(out)):
+            self.assertEqual(phases_impl._firmware_partitions(), ["/dev/sda3", "/dev/sdb3"])
+
+    def test_ignores_the_label_on_another_filesystem(self):
+        with mock.patch.object(phases_impl.subprocess, "run", return_value=lsblk("/dev/sda3 OMARCHY_FW ntfs\n")):
+            self.assertEqual(phases_impl._firmware_partitions(), [])
+
+    def test_none_without_the_partition(self):
+        with mock.patch.object(phases_impl.subprocess, "run", return_value=lsblk("/dev/sda1 OMARCHY_ISO iso9660\n")):
+            self.assertEqual(phases_impl._firmware_partitions(), [])
+
+
+class StageFromPartitionTest(unittest.TestCase):
+    """Partitions map to driver stores; staging finds files only in one that
+    holds them, as qcom-firmware-extract does."""
+
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp())
+        self.stage = self.tmp / "stage"
+        self.mount = self.tmp / "mount"
+        self.contents = {}
+        self.mounted = None
+        self.calls = []
+
+    def partition(self, device, files):
+        self.contents[device] = files
+
+    def fake_run(self, cmd, **kwargs):
+        self.calls.append(cmd)
+        if cmd[0] == "mount":
+            self.mounted = cmd[-2]
+            store = self.mount / "DriverStore" / "FileRepository"
+            if self.mount.exists():
+                shutil.rmtree(self.mount)
+            if self.contents[self.mounted]:
+                folder = store / "qcsubsys.inf_arm64_x"
+                folder.mkdir(parents=True)
+                for name in self.contents[self.mounted]:
+                    (folder / name).write_bytes(b"x")
+            else:
+                self.mount.mkdir(parents=True)
+        elif "--stage" in cmd:
+            self.stage.mkdir(parents=True, exist_ok=True)
+            found = "-d" in cmd and bool(self.contents.get(self.mounted))
+            with open(self.stage / "manifest", "a") as manifest:
+                if found:
+                    manifest.write("qcom/x/qcadsp8380.mbn\n")
+        return types.SimpleNamespace(returncode=0, stdout="")
+
+    def stage_with(self, *partitions):
+        with mock.patch.object(phases_impl, "LIVE_FIRMWARE_STAGE", self.stage), \
+             mock.patch.object(phases_impl, "FIRMWARE_PARTITION_MOUNT", self.mount), \
+             mock.patch.object(phases_impl, "_firmware_partitions", return_value=list(partitions)), \
+             mock.patch.object(phases_impl.shutil, "which", return_value="/usr/bin/qcom-firmware-extract"), \
+             mock.patch.object(phases_impl.subprocess, "run", side_effect=self.fake_run), \
+             mock.patch.object(phases_impl, "info"):
+            phases_impl._stage_qualcomm_firmware()
+
+    def staging_calls(self):
+        return [c for c in self.calls if "--stage" in c]
+
+    def test_stages_from_the_partition_and_not_from_windows(self):
+        self.partition("/dev/sda3", ["qcadsp8380.mbn"])
+        self.stage_with("/dev/sda3")
+        self.assertEqual(len(self.staging_calls()), 1)
+        self.assertEqual(self.staging_calls()[0][-2:], ["-d", str(self.mount / "DriverStore" / "FileRepository")])
+        self.assertTrue((self.stage / "driver-store" / "qcsubsys.inf_arm64_x" / "qcadsp8380.mbn").is_file())
+        self.assertIn(["umount", str(self.mount)], self.calls)
+
+    def test_skips_an_empty_partition_for_the_next_one(self):
+        self.partition("/dev/sda3", [])
+        self.partition("/dev/sdb3", ["qcadsp8380.mbn"])
+        self.stage_with("/dev/sda3", "/dev/sdb3")
+        mounts = [c[-2] for c in self.calls if c[0] == "mount"]
+        self.assertEqual(mounts, ["/dev/sda3", "/dev/sdb3"])
+        self.assertTrue(all("-d" in c for c in self.staging_calls()))
+
+    def test_falls_back_to_windows_when_the_partition_has_nothing(self):
+        self.partition("/dev/sda3", [])
+        self.stage_with("/dev/sda3")
+        self.assertEqual(self.staging_calls()[-1], ["/usr/bin/qcom-firmware-extract", "--stage", str(self.stage)])
+
+    def test_falls_back_to_windows_without_a_partition(self):
+        self.stage_with()
+        self.assertEqual(self.staging_calls(), [["/usr/bin/qcom-firmware-extract", "--stage", str(self.stage)]])
+
+
+if __name__ == "__main__":
+    unittest.main()
-- 
