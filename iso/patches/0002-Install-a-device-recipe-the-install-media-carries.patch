+++ b/configs/airootfs/usr/share/omarchy-iso/orchestrator/recipe.py
@@ -0,0 +1,230 @@
+"""Device recipes: a machine's add-on packages, carried on the install media.
+
+A USB creator that recognises the machine (the Omarchy Arm installer, from
+Windows) can put a recipe on the OMARCHY_FW partition:
+
+    recipe/recipe.json      which repository and packages, and its key
+    recipe/key.asc          the repository's signing key
+    recipe/repo/            the packages, and the repository database
+
+The packages are installed with the system, their dependencies coming from
+the image's offline mirror; the repository is then configured above
+[omarchy] for updates. When something they need is not on the media, a
+first-boot service installs them once the machine is online instead.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+from .context import InstallContext
+from .ui import info
+
+RECIPE_LABEL = "OMARCHY_FW"
+MEDIA_MOUNT = Path("/run/omarchy/recipe-media")
+# Inside the target, where arch-chroot does not hide it (it mounts its own /run).
+TARGET_MEDIA = "var/cache/omarchy/recipe"
+TARGET_RECIPE = "etc/omarchy/recipe"
+FIRSTBOOT = "omarchy-recipe-firstboot"
+BEGIN = "# BEGIN OMARCHY DEVICE RECIPE"
+END = "# END OMARCHY DEVICE RECIPE"
+RESERVED_REPOS = {"options", "offline", "omarchy", "core", "extra", "multilib", "alarm", "aur", "platform"}
+
+
+def read(folder: Path) -> dict | None:
+    """The recipe in <folder>, or None when there is none or it is malformed."""
+    try:
+        recipe = json.loads((folder / "recipe.json").read_text())
+    except (OSError, ValueError):
+        return None
+    if not isinstance(recipe, dict):
+        return None
+    repo = recipe.get("repo")
+    packages = recipe.get("packages")
+    if not isinstance(repo, dict) or not isinstance(packages, list) or not packages:
+        return None
+    name = repo.get("name")
+    if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,39}", name) or name in RESERVED_REPOS:
+        return None
+    server = repo.get("server")
+    if not isinstance(server, str) or not re.fullmatch(r"https://[A-Za-z0-9._~:/?#@!&'()*+,;=%$-]+", server):
+        return None
+    fingerprint = repo.get("keyFingerprint")
+    if not isinstance(fingerprint, str) or not re.fullmatch(r"[0-9A-F]{40}", fingerprint):
+        return None
+    if not all(isinstance(p, str) and re.fullmatch(r"[a-z0-9@._+-]+", p) for p in packages):
+        return None
+    if not (folder / "key.asc").is_file() or not (folder / "repo" / f"{name}.db").is_file():
+        return None
+    return recipe
+
+
+def _partitions() -> list[str]:
+    out = subprocess.run(["lsblk", "-rno", "PATH,LABEL,FSTYPE"], capture_output=True, text=True, check=False).stdout
+    return [f[0] for f in (line.split(" ") for line in out.splitlines())
+            if len(f) == 3 and f[1] == RECIPE_LABEL and f[2] == "vfat"]
+
+
+def stage(ctx: InstallContext) -> None:
+    """Find a recipe on the install media and keep its partition mounted for
+    the install."""
+    for partition in _partitions():
+        MEDIA_MOUNT.mkdir(parents=True, exist_ok=True)
+        if subprocess.run(["mount", "-o", "ro,nosuid,nodev,noexec", partition, str(MEDIA_MOUNT)], check=False).returncode != 0:
+            continue
+        recipe = read(MEDIA_MOUNT / "recipe")
+        if recipe is not None:
+            info(f"› device recipe {recipe.get('name', recipe['repo']['name'])}: "
+                 f"{', '.join(recipe['packages'])} from {partition}")
+            ctx.state["recipe"] = recipe
+            return
+        subprocess.run(["umount", str(MEDIA_MOUNT)], check=False)
+
+
+def offline_config(recipe: dict) -> str:
+    """pacman.conf for installing from the media: the recipe's repository
+    first, so its packages win, then the offline mirror."""
+    name = recipe["repo"]["name"]
+    return (
+        "[options]\nArchitecture = auto\nSigLevel = Required DatabaseOptional\n"
+        "LocalFileSigLevel = Optional\nNoProgressBar\n\n"
+        # The media's packages are checked against the database by the
+        # creator; signatures are checked from the first online sync on.
+        f"[{name}]\nSigLevel = Never\nServer = file:///{TARGET_MEDIA}/recipe/repo\n\n"
+        "[offline]\nSigLevel = Never\nServer = file:///var/cache/omarchy/mirror/offline/\n"
+    )
+
+
+def online_section(recipe: dict) -> str:
+    repo = recipe["repo"]
+    return f"{BEGIN}\n[{repo['name']}]\nServer = {repo['server']}\n{END}\n"
+
+
+def add_online_repo(pacman_conf: Path, recipe: dict) -> None:
+    """The recipe's repository above every other one, so its packages replace
+    Omarchy's of the same name. Idempotent."""
+    text = pacman_conf.read_text()
+    text = re.sub(rf"\n?{re.escape(BEGIN)}\n.*?{re.escape(END)}\n", "\n", text, flags=re.S)
+    section = online_section(recipe)
+    first = re.search(r"^\[(?!options\])", text, flags=re.M)
+    text = text[:first.start()] + section + "\n" + text[first.start():] if first else text.rstrip("\n") + "\n\n" + section
+    pacman_conf.write_text(text)
+
+
+def _targets(recipe: dict, available: list[str], installed: set[str]) -> list[str]:
+    """The recipe's packages, plus every installed package its repository
+    replaces (the kernel, say), each named with its repository."""
+    name = recipe["repo"]["name"]
+    wanted = list(recipe["packages"]) + sorted(p for p in available if p in installed and p not in recipe["packages"])
+    return [f"{name}/{p}" for p in wanted if p in available]
+
+
+FIRSTBOOT_SCRIPT = """#!/bin/bash
+# Installs this machine's device recipe once it is online; the install could
+# not, because something the packages need was not on the install media.
+set -u
+recipe=/etc/omarchy/recipe
+read -r repo < "$recipe/repo"
+read -r fingerprint < "$recipe/fingerprint"
+if ! pacman-key --list-keys "$fingerprint" >/dev/null 2>&1; then
+  pacman-key --add "$recipe/key.asc" && pacman-key --lsign-key "$fingerprint" || exit 1
+fi
+mapfile -t packages < "$recipe/packages"
+pacman -Sy --noconfirm --needed "${packages[@]/#/$repo/}" || exit 1
+rm -f "$recipe/pending"
+"""
+
+FIRSTBOOT_UNIT = f"""[Unit]
+Description=Install this machine's device recipe
+Wants=network-online.target
+After=network-online.target
+ConditionPathExists=/{TARGET_RECIPE}/pending
+StartLimitIntervalSec=0
+
+[Service]
+Type=oneshot
+ExecStart=/usr/lib/omarchy/{FIRSTBOOT}
+Restart=on-failure
+RestartSec=5min
+
+[Install]
+WantedBy=multi-user.target
+"""
+
+
+def _chroot(ctx: InstallContext, *cmd: str, capture: bool = False) -> subprocess.CompletedProcess:
+    return subprocess.run(["arch-chroot", str(ctx.target), *cmd], check=False, text=True,
+                          capture_output=capture)
+
+
+def install(ctx: InstallContext) -> None:
+    """Phase: install the recipe's packages and configure its repository.
+    Runs after the system finalizer, which writes the online pacman.conf, and
+    before the final UKI build, which picks up a kernel the recipe replaces."""
+    recipe = ctx.state.get("recipe")
+    if not recipe:
+        return
+    from .phases_impl import TARGET_DEFERRED_BOOT_HOOKS, _mask_mkinitcpio_pacman_hooks, _unmask_mkinitcpio_pacman_hooks
+
+    name = recipe["repo"]["name"]
+    saved = ctx.target / TARGET_RECIPE
+    saved.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(MEDIA_MOUNT / "recipe" / "recipe.json", saved / "recipe.json")
+    shutil.copy2(MEDIA_MOUNT / "recipe" / "key.asc", saved / "key.asc")
+    (saved / "repo").write_text(name + "\n")
+    (saved / "fingerprint").write_text(recipe["repo"]["keyFingerprint"] + "\n")
+
+    media = ctx.target / TARGET_MEDIA
+    media.mkdir(parents=True, exist_ok=True)
+    subprocess.run(["mount", "--bind", str(MEDIA_MOUNT), str(media)], check=True)
+    ctx.state.setdefault("bind_mounts", []).append(str(media))
+
+    conf = saved / "pacman-offline.conf"
+    conf.write_text(offline_config(recipe))
+    config = f"/{TARGET_RECIPE}/pacman-offline.conf"
+
+    installed_ok = False
+    _mask_mkinitcpio_pacman_hooks(ctx, ctx.target, TARGET_DEFERRED_BOOT_HOOKS)
+    try:
+        if _chroot(ctx, "pacman", "--config", config, "-Sy").returncode == 0:
+            available = _chroot(ctx, "pacman", "--config", config, "-Slq", name, capture=True).stdout.split()
+            installed = set(_chroot(ctx, "pacman", "-Qq", capture=True).stdout.split())
+            targets = _targets(recipe, available, installed)
+            (saved / "packages").write_text("\n".join(t.split("/", 1)[1] for t in targets) + "\n")
+            info(f"› installing the device recipe: {' '.join(targets)}")
+            installed_ok = bool(targets) and _chroot(ctx, "pacman", "--config", config, "-S", "--noconfirm", *targets).returncode == 0
+    finally:
+        _unmask_mkinitcpio_pacman_hooks(ctx, ctx.target, TARGET_DEFERRED_BOOT_HOOKS)
+        subprocess.run(["umount", str(media)], check=False)
+        try:
+            ctx.state["bind_mounts"].remove(str(media))
+        except ValueError:
+            pass
+
+    add_online_repo(ctx.target / "etc" / "pacman.conf", recipe)
+    fingerprint = recipe["repo"]["keyFingerprint"]
+    key = f"/{TARGET_RECIPE}/key.asc"
+    keyed = (_chroot(ctx, "pacman-key", "--add", key).returncode == 0
+             and _chroot(ctx, "pacman-key", "--lsign-key", fingerprint).returncode == 0)
+
+    if installed_ok and keyed:
+        return
+    if not (saved / "packages").exists():
+        (saved / "packages").write_text("\n".join(recipe["packages"]) + "\n")
+    info("› the device recipe finishes on first boot, once the machine is online")
+    (saved / "pending").touch()
+    script = ctx.target / "usr/lib/omarchy" / FIRSTBOOT
+    script.parent.mkdir(parents=True, exist_ok=True)
+    script.write_text(FIRSTBOOT_SCRIPT)
+    script.chmod(0o755)
+    unit = ctx.target / "etc/systemd/system" / f"{FIRSTBOOT}.service"
+    unit.write_text(FIRSTBOOT_UNIT)
+    wants = ctx.target / "etc/systemd/system/multi-user.target.wants"
+    wants.mkdir(parents=True, exist_ok=True)
+    link = wants / f"{FIRSTBOOT}.service"
+    if not link.exists():
+        link.symlink_to(f"/etc/systemd/system/{FIRSTBOOT}.service")
diff --git a/test/unit/test_device_recipe.py b/test/unit/test_device_recipe.py
new file mode 100644
index 0000000..7a15433
--- /dev/null
+++ b/test/unit/test_device_recipe.py
@@ -0,0 +1,159 @@
+"""Device recipes on the install media: what the installer accepts, how it
+orders the repository, and which packages it installs from it."""
+
+import json
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "configs/airootfs/usr/share/omarchy-iso"))
+sys.modules.setdefault(
+    "orchestrator.archinstall_adapter",
+    types.ModuleType("orchestrator.archinstall_adapter"),
+)
+from orchestrator import recipe  # noqa: E402
+
+FINGERPRINT = "6CAC3F8AE94AC7BDCFB7A9017C8D01DD008051AB"
+
+
+def a_recipe(**changes):
+    r = {
+        "name": "Surface Pro 11 extras",
+        "repo": {
+            "name": "surface-pro-11",
+            "server": "https://github.com/turbineBMW/surface-pro-11-omarchy/releases/download/$arch",
+            "keyFingerprint": FINGERPRINT,
+        },
+        "packages": ["omarchy-surface-pro-11", "surface-pro-11-plugins"],
+    }
+    r.update(changes)
+    return r
+
+
+class ReadTest(unittest.TestCase):
+    def setUp(self):
+        self.folder = Path(tempfile.mkdtemp())
+        (self.folder / "repo").mkdir()
+        (self.folder / "repo" / "surface-pro-11.db").touch()
+        (self.folder / "key.asc").touch()
+
+    def write(self, r):
+        (self.folder / "recipe.json").write_text(json.dumps(r))
+        return recipe.read(self.folder)
+
+    def test_accepts_a_whole_recipe(self):
+        self.assertEqual(self.write(a_recipe())["repo"]["name"], "surface-pro-11")
+
+    def test_needs_the_database_and_the_key(self):
+        (self.folder / "key.asc").unlink()
+        self.assertIsNone(self.write(a_recipe()))
+
+    def test_refuses_a_repository_named_like_omarchys(self):
+        r = a_recipe()
+        r["repo"]["name"] = "omarchy"
+        (self.folder / "repo" / "omarchy.db").touch()
+        self.assertIsNone(self.write(r))
+
+    def test_refuses_a_name_that_could_break_pacman_conf(self):
+        r = a_recipe()
+        r["repo"]["name"] = "x]\nServer = http://evil"
+        self.assertIsNone(self.write(r))
+
+    def test_refuses_plain_http_and_short_fingerprints(self):
+        r = a_recipe()
+        r["repo"]["server"] = "http://example.com/$arch"
+        self.assertIsNone(self.write(r))
+        r = a_recipe()
+        r["repo"]["keyFingerprint"] = "008051AB"
+        self.assertIsNone(self.write(r))
+
+    def test_refuses_odd_package_names_and_no_packages(self):
+        self.assertIsNone(self.write(a_recipe(packages=["ok", "--overwrite=*"])))
+        self.assertIsNone(self.write(a_recipe(packages=[])))
+
+    def test_refuses_garbage(self):
+        (self.folder / "recipe.json").write_text("not json")
+        self.assertIsNone(recipe.read(self.folder))
+
+
+class PacmanConfTest(unittest.TestCase):
+    CONF = "[options]\nArchitecture = auto\n\n[omarchy]\nServer = https://pkgs.omarchy.org/edge/$arch\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n"
+
+    def setUp(self):
+        self.path = Path(tempfile.mkdtemp()) / "pacman.conf"
+        self.path.write_text(self.CONF)
+
+    def test_goes_above_every_repository(self):
+        recipe.add_online_repo(self.path, a_recipe())
+        text = self.path.read_text()
+        self.assertLess(text.index("[options]"), text.index("[surface-pro-11]"))
+        self.assertLess(text.index("[surface-pro-11]"), text.index("[omarchy]"))
+        self.assertIn("Server = https://github.com/turbineBMW/surface-pro-11-omarchy/releases/download/$arch", text)
+
+    def test_twice_leaves_one_section(self):
+        recipe.add_online_repo(self.path, a_recipe())
+        recipe.add_online_repo(self.path, a_recipe())
+        self.assertEqual(self.path.read_text().count("[surface-pro-11]"), 1)
+        self.assertEqual(self.path.read_text().count(recipe.BEGIN), 1)
+
+    def test_offline_config_puts_the_media_first(self):
+        conf = recipe.offline_config(a_recipe())
+        self.assertLess(conf.index("[surface-pro-11]"), conf.index("[offline]"))
+        self.assertIn(f"file:///{recipe.TARGET_MEDIA}/recipe/repo", conf)
+
+
+class TargetsTest(unittest.TestCase):
+    def test_recipe_packages_and_what_the_repository_replaces(self):
+        available = ["omarchy-surface-pro-11", "surface-pro-11-plugins", "linux-omarchy", "linux-omarchy-headers", "facelock"]
+        installed = {"linux-omarchy", "linux-omarchy-headers", "bash"}
+        self.assertEqual(
+            recipe._targets(a_recipe(), available, installed),
+            ["surface-pro-11/omarchy-surface-pro-11", "surface-pro-11/surface-pro-11-plugins",
+             "surface-pro-11/linux-omarchy", "surface-pro-11/linux-omarchy-headers"],
+        )
+
+    def test_skips_what_the_repository_does_not_have(self):
+        self.assertEqual(recipe._targets(a_recipe(), ["surface-pro-11-plugins"], set()),
+                         ["surface-pro-11/surface-pro-11-plugins"])
+
+
+class StageTest(unittest.TestCase):
+    def test_keeps_the_partition_with_a_recipe_mounted(self):
+        media = Path(tempfile.mkdtemp())
+        lsblk = types.SimpleNamespace(stdout="/dev/sda3 OMARCHY_FW vfat\n/dev/sdb3 OMARCHY_FW vfat\n", returncode=0)
+        calls = []
+
+        def run(cmd, **kwargs):
+            calls.append(cmd)
+            if cmd[0] == "lsblk":
+                return lsblk
+            if cmd[0] == "mount":
+                # Only the second partition carries a recipe.
+                folder = media / "recipe"
+                if cmd[-2] == "/dev/sdb3":
+                    (folder / "repo").mkdir(parents=True)
+                    (folder / "repo" / "surface-pro-11.db").touch()
+                    (folder / "key.asc").touch()
+                    (folder / "recipe.json").write_text(json.dumps(a_recipe()))
+            return types.SimpleNamespace(returncode=0, stdout="")
+
+        ctx = types.SimpleNamespace(state={})
+        with mock.patch.object(recipe, "MEDIA_MOUNT", media), mock.patch.object(recipe.subprocess, "run", side_effect=run):
+            recipe.stage(ctx)
+        self.assertEqual(ctx.state["recipe"]["repo"]["name"], "surface-pro-11")
+        self.assertEqual([c[0] for c in calls], ["lsblk", "mount", "umount", "mount"])
+
+    def test_nothing_without_a_recipe(self):
+        lsblk = types.SimpleNamespace(stdout="/dev/sda1 OMARCHY_ISO iso9660\n", returncode=0)
+        ctx = types.SimpleNamespace(state={})
+        with mock.patch.object(recipe.subprocess, "run", return_value=lsblk):
+            recipe.stage(ctx)
+        self.assertNotIn("recipe", ctx.state)
+
+
+if __name__ == "__main__":
+    unittest.main()
