+class KeyringTest(unittest.TestCase):
+    """The keyring pacman checks the media with trusts the recipe's key, and
+    only when it is the key the recipe names."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = Path(tempfile.mkdtemp())
+        home = cls.tmp / "maker"
+        home.mkdir(mode=0o700)
+        env = {**os.environ, "GNUPGHOME": str(home)}
+        subprocess.run(["gpg", "--batch", "--quiet", "--pinentry-mode", "loopback", "--passphrase", "",
+                        "--quick-gen-key", "Recipe Test <test@example.invalid>", "ed25519", "sign", "never"],
+                       env=env, check=True, capture_output=True)
+        listed = subprocess.run(["gpg", "--with-colons", "--list-keys"], env=env, check=True,
+                                capture_output=True, text=True).stdout
+        cls.fingerprint = next(line.split(":")[9] for line in listed.splitlines() if line.startswith("fpr:"))
+        cls.key = cls.tmp / "key.asc"
+        cls.key.write_text(subprocess.run(["gpg", "--armor", "--export", cls.fingerprint], env=env, check=True,
+                                          capture_output=True, text=True).stdout)
