+def official_config() -> str:
+    """pacman.conf for the official packages the media carries: installed as
+    files, each signature checked against the system keyring (Omarchy's and
+    Arch Linux ARM's keys), dependencies from the offline mirror."""
+    return (
+        "[options]\nArchitecture = auto\nNoProgressBar\nLocalFileSigLevel = Required\n\n"
+        "[offline]\nSigLevel = Never\nServer = file:///var/cache/omarchy/mirror/offline/\n"
+    )
+
+
+PACKAGE_FILE = re.compile(r"[a-z0-9@._+-]+-[A-Za-z0-9._:+~-]+-[A-Za-z0-9._+-]+-[a-z0-9_]+\.pkg\.tar\.[a-z0-9]+")
+
+
+def official_files(media: Path) -> list[str]:
+    """The package files under recipe/official on the media, each with its
+    signature beside it. An odd name or a missing signature fails the install
+    rather than being skipped: the stick is meant to be complete."""
+    folder = media / "recipe" / "official"
+    if not folder.is_dir():
+        return []
+    files = []
+    for path in sorted(folder.iterdir()):
+        if path.name.endswith(".sig") or not path.is_file():
+            continue
+        if path.name.startswith(".") or not PACKAGE_FILE.fullmatch(path.name):
+            raise RuntimeError(f"not a package file among the media's official packages: {path.name}")
+        if not (folder / f"{path.name}.sig").is_file():
+            raise RuntimeError(f"{path.name} on the install media has no signature")
+        files.append(path.name)
+    return files
+
+
+def make_keyring(home: Path, key: Path, fingerprint: str) -> bool:
+    """A GnuPG home trusting only the recipe's key, for pacman's GPGDir and
+    omarchy-recipe's checks."""
+    home.mkdir(parents=True, exist_ok=True)
+    home.chmod(0o700)
+    # As pacman-key --init: pacman looks for pubring.gpg, and gpg keeps the
+    # keys in it when it exists rather than starting a pubring.kbx.
+    (home / "pubring.gpg").touch()
+    gpg =["gpg", "--homedir", str(home), "--batch", "--quiet"]
+    if subprocess.run([*gpg, "--import", str(key)], check=False).returncode != 0:
+        return False
+    listed = subprocess.run([*gpg, "--with-colons", "--list-keys"], capture_output=True, text=True, check=False).stdout
+    if f"fpr:::::::::{fingerprint}:" not in listed:
+        return False
+    return subprocess.run([*gpg, "--import-ownertrust"], input=f"{fingerprint}:6:\n", text=True,
+                          check=False).returncode == 0
+
+
