+trap 'rm -rf "$work"' EXIT
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+export OMARCHY_RECIPE_DIR=$work/recipe OMARCHY_RECIPE_STATE=$work/state PACMAN_CONF=$work/pacman.conf
+mkdir -p "$work/bin"
+setup() {
+rm -rf "$OMARCHY_RECIPE_DIR" "$OMARCHY_RECIPE_DIR".removed-* "$OMARCHY_RECIPE_STATE"
+mkdir -p "$OMARCHY_RECIPE_DIR"
+: >"$work/calls"
+cat >"$OMARCHY_RECIPE_DIR/recipe.json" <<'JSON'
+{"name": "Surface Pro 11 extras", "maintainer": {"name": "Someone"},
+ "repo": {"name": "surface-pro-11", "server": "https://example.invalid/$arch",
+          "keyFingerprint": "6CAC3F8AE94AC7BDCFB7A9017C8D01DD008051AB"},
+ "packages": ["omarchy-surface-pro-11"]}
+JSON
+cat >"$OMARCHY_RECIPE_DIR/info.json" <<'JSON'
+{"format": 1, "repo": "surface-pro-11", "name": "Surface Pro 11 extras", "status": "active",
+ "packages": [{"name": "linux-omarchy", "replaces": true, "description": "k"},
+              {"name": "surface-pro-11-plugins", "replaces": false, "description": "p"}]}
+JSON
+cat >"$PACMAN_CONF" <<'CONF'
+[options]
+Architecture = auto
+
+# BEGIN OMARCHY DEVICE RECIPE
+[surface-pro-11]
+Server = https://example.invalid/$arch
+# END OMARCHY DEVICE RECIPE
+
+[omarchy]
+Server = https://pkgs.omarchy.org/edge/$arch
+CONF
+}
+setup
+
+# pacman: the recipe repository has the kernel and the plugins; once it is
+# gone from pacman.conf, only the kernel is still to be had (from Omarchy).
+cat >"$work/bin/pacman" <<'STUB'
+#!/bin/bash
+echo "pacman $*" >>"$WORK/calls"
+case $1 in
+  -Slq) grep -q '^\[surface-pro-11\]' "$PACMAN_CONF" && printf 'linux-omarchy\nsurface-pro-11-plugins\nfacelock\n' ;;
+  -Qq) [[ $2 == linux-omarchy || $2 == surface-pro-11-plugins ]] ;;
+  -Sp) [[ ${*: -1} == linux-omarchy ]] ;;
+  *) exit 0 ;;
+esac
+STUB
+for stub in pacman-key systemctl; do
+  printf '#!/bin/bash\necho "%s $*" >>"$WORK/calls"\n' "$stub" >"$work/bin/$stub"
+done
+chmod +x "$work/bin"/*
+export PATH=$work/bin:$PATH WORK=$work
+
+out=$("$TOOL")
+grep -q "not part of Omarchy" <<<"$out" || fail "status does not say it is not Omarchy's"
+grep -q "linux-omarchy  (replaces Omarchy's)" <<<"$out" || fail "status does not mark what it replaces"
+grep -q "surface-pro-11-plugins$" <<<"$out" || fail "status does not list the plugins"
+grep -q facelock <<<"$out" && fail "status lists a package that is not installed"
+
+[[ -z $("$TOOL" notice) ]] || fail "an active recipe gives a notice"
+mkdir -p "$OMARCHY_RECIPE_STATE"
+jq '.status = "retired" | .retiredMessage = "Omarchy 4 has it all."' "$OMARCHY_RECIPE_DIR/info.json" >"$OMARCHY_RECIPE_STATE/info.json"
+grep -q "retired this repository. Omarchy 4 has it all." <<<"$("$TOOL" notice)" || fail "no notice once retired"
+grep -q "sudo omarchy-recipe remove" <<<"$("$TOOL")" || fail "status does not say how to remove it"
+
+out=$("$TOOL" remove --yes)
+grep -q 'BEGIN OMARCHY DEVICE RECIPE\|surface-pro-11' "$PACMAN_CONF" && fail "the repository is still in pacman.conf"
+grep -q '^\[omarchy\]' "$PACMAN_CONF" || fail "removal took Omarchy's repository too"
+grep -q "pacman-key --delete 6CAC3F8AE94AC7BDCFB7A9017C8D01DD008051AB" "$work/calls" || fail "the key stays trusted"
+grep -q "pacman -S --noconfirm linux-omarchy" "$work/calls" || fail "the kernel does not go back to Omarchy's"
+grep -q "Kept, but no longer updated: surface-pro-11-plugins" <<<"$out" || fail "what only it had is not reported"
+grep -q "pacman -Rns" "$work/calls" && fail "removed packages without --purge"
+[[ ! -e $OMARCHY_RECIPE_DIR && -n $(compgen -G "$OMARCHY_RECIPE_DIR.removed-*") ]] || fail "the recipe is not set aside"
+grep -q "Removed\|no device recipe" <<<"$("$TOOL")" || fail "status after removal"
+
+setup
+"$TOOL" remove --yes --purge >/dev/null
+grep -q "pacman -Rns --noconfirm surface-pro-11-plugins$" "$work/calls" || fail "--purge does not remove what only it had"
+grep -q "pacman -Rns.*linux-omarchy" "$work/calls" && fail "--purge removes a package Omarchy has"
+echo "omarchy-recipe: ok"
