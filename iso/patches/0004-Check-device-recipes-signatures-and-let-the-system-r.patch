index 0000000..6a41f71
--- /dev/null
+++ b/configs/airootfs/usr/share/omarchy-iso/recipe/omarchy-recipe
@@ -0,0 +1,136 @@
+#!/bin/bash
+# This machine's device recipe: a package repository from outside Omarchy,
+# added while Omarchy was installed from a stick the Omarchy Arm installer
+# made. It replaces some of Omarchy's packages with its maintainer's until
+# Omarchy has the same.
+#
+#   omarchy-recipe                 what it is, and what came from it
+#   omarchy-recipe check           fetch its signed description (daily timer)
+#   omarchy-recipe remove [--purge] [--yes]
+#                                  take the repository out of pacman and go
+#                                  back to Omarchy's own packages; --purge
+#                                  also removes the ones only it had
+set -euo pipefail
+
+# The paths can be moved for tests.
+recipe=${OMARCHY_RECIPE_DIR:-/etc/omarchy/recipe}
+state=${OMARCHY_RECIPE_STATE:-/var/lib/omarchy/recipe}
+conf=${PACMAN_CONF:-/etc/pacman.conf}
+begin="# BEGIN OMARCHY DEVICE RECIPE"
+end="# END OMARCHY DEVICE RECIPE"
+
+die() { printf 'omarchy-recipe: %s\n' "$*" >&2; exit 1; }
+field() { jq -r "$1 // empty" "$recipe/recipe.json"; }
+info_file() { if [[ -f $state/info.json ]]; then echo "$state/info.json"; else echo "$recipe/info.json"; fi; }
+info() { local f; f=$(info_file); [[ -f $f ]] && jq -r "$1 // empty" "$f"; }
+configured() { grep -qxF "$begin" "$conf"; }
+root() { ((EUID == 0)) || [[ -n ${OMARCHY_RECIPE_DIR:-} ]] || die "run it as root: sudo omarchy-recipe $*"; }
+
+[[ -f $recipe/recipe.json ]] || { echo "This machine has no device recipe."; exit 0; }
+name=$(field .name)
+repo=$(field .repo.name)
+fingerprint=$(field .repo.keyFingerprint)
+server=$(field .repo.server)
+server=${server//\$arch/$(uname -m)}
+
+installed_from_repo() {
+  { pacman -Slq "$repo" 2>/dev/null || true; } | while read -r p; do
+    if pacman -Qq "$p" >/dev/null 2>&1; then echo "$p"; fi
+  done
+}
+
+status() {
+  echo "$name, from $(field .maintainer.name): not part of Omarchy"
+  echo "  Repository  $server"
+  echo "  Key         $fingerprint"
+  if ! configured; then
+    echo "  Removed: pacman no longer uses it."
+    return
+  fi
+  if [[ $(info .status) == retired ]]; then
+    echo "  Retired by its maintainer: $(info .retiredMessage)"
+    echo "  Go back to Omarchy's own packages with: sudo omarchy-recipe remove"
+  fi
+  echo "  Installed from it:"
+  installed_from_repo | while read -r p; do
+    replaces=$(jq -r --arg p "$p" '.packages[]? | select(.name == $p) | .replaces' "$(info_file)" 2>/dev/null || true)
+    printf '    %s%s\n' "$p" "$([[ $replaces == true ]] && echo "  (replaces Omarchy's)")"
+  done
+}
+
+check() {
+  root check
+  configured || return 0
+  local tmp
+  tmp=$(mktemp -d)
+  trap 'rm -rf "$tmp"' RETURN
+  curl -fsSL --max-time 60 -o "$tmp/info.json" "$server/$repo.recipe.json" &&
+    curl -fsSL --max-time 60 -o "$tmp/info.json.sig" "$server/$repo.recipe.json.sig" ||
+    die "could not fetch the repository's description from $server"
+  gpg --homedir "$recipe/gnupg" --batch --status-fd 1 --verify "$tmp/info.json.sig" "$tmp/info.json" 2>/dev/null |
+    grep -qE "^\[GNUPG:\] VALIDSIG .* $fingerprint\$" ||
+    die "the repository's description is not signed by key $fingerprint"
+  jq -e --arg r "$repo" '.format == 1 and .repo == $r' "$tmp/info.json" >/dev/null ||
+    die "that is not this repository's description"
+  install -D -m 644 "$tmp/info.json" "$state/info.json"
+}
+
+notice() {
+  configured && [[ $(info .status) == retired ]] || return 0
+  echo ":: $name: its maintainer has retired this repository. $(info .retiredMessage)"
+  echo ":: Go back to Omarchy's own packages with: sudo omarchy-recipe remove"
+}
+
+remove() {
+  root remove
+  local purge=0 yes=0
+  for arg in "$@"; do
+    case $arg in
+      --purge) purge=1 ;;
+      --yes) yes=1 ;;
+      *) die "unknown option $arg" ;;
+    esac
+  done
+  mapfile -t from < <(installed_from_repo)
+  echo "Removing $name ($repo) from pacman."
+  ((${#from[@]})) && echo "Installed from it: ${from[*]}"
+  if ((!yes)); then
+    read -r -p "Continue? [y/N] " answer
+    [[ $answer == [yY]* ]] || exit 1
+  fi
+
+  awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$conf" >"$conf.recipe-new"
+  cat "$conf.recipe-new" >"$conf"
+  rm -f "$conf.recipe-new"
+  pacman-key --delete "$fingerprint" >/dev/null 2>&1 || true
+  pacman -Sy
+
+  # What Omarchy has too goes back to Omarchy's build of it; the rest stays,
+  # without updates, unless --purge.
+  local back=() only=() p
+  for p in "${from[@]}"; do
+    if pacman -Sp --print-format %n "$p" >/dev/null 2>&1; then back+=("$p"); else only+=("$p"); fi
+  done
+  ((${#back[@]})) && pacman -S --noconfirm "${back[@]}"
+  if ((${#only[@]})); then
+    if ((purge)); then
+      pacman -Rns --noconfirm "${only[@]}"
+    else
+      echo "Kept, but no longer updated: ${only[*]}"
+      echo "Remove them with: sudo pacman -Rns ${only[*]}"
+    fi
+  fi
+
+  systemctl disable --now omarchy-recipe-check.timer >/dev/null 2>&1 || true
+  rm -rf "$state"
+  mv "$recipe" "$recipe.removed-$(date +%Y%m%d%H%M%S)"
+  echo "Done: $name is removed."
+}
+
+case ${1:-} in
+  "" | status) status ;;
+  check) check ;;
+  notice) notice ;;
+  remove) shift; remove "$@" ;;
+  *) die "usage: omarchy-recipe [status|check|remove [--purge] [--yes]]" ;;
+esac
