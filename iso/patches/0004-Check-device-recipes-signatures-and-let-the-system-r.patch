+#!/bin/bash
+# omarchy-recipe on an installed system: what it shows, the retirement
+# notice, and removal, with pacman, pacman-key and systemctl stubbed.
+set -euo pipefail
+
+ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
+TOOL=$ROOT/configs/airootfs/usr/share/omarchy-iso/recipe/omarchy-recipe
