+#!/bin/bash
+# Installs this machine's device recipe once it is online; the install could
+# not, because something the packages need was not on the install media.
+set -u
+recipe=/etc/omarchy/recipe
+read -r repo < "$recipe/repo"
+read -r fingerprint < "$recipe/fingerprint"
+if ! pacman-key --list-keys "$fingerprint" >/dev/null 2>&1; then
+  pacman-key --add "$recipe/key.asc" && pacman-key --lsign-key "$fingerprint" || exit 1
+fi
+mapfile -t packages < "$recipe/packages"
+pacman -Sy --noconfirm --needed "${packages[@]/#/$repo/}" || exit 1
+rm -f "$recipe/pending"
